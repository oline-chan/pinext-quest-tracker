# Quest Tracker — environment variables (copy to .env locally, or set
# them in your hosting dashboard). NEVER commit a real .env, and NEVER
# put PI_API_KEY in the frontend, in git, or in chat.
#
# Port the server listens on. Render sets PORT itself; locally it
# defaults to 3000.
PORT=3000
# "true" = Pi sandbox (Testnet, no real Pi moves). "false" = production.
# The frontend reads this from /api/health, so one variable controls
# both server and Pi.init() sandbox mode.
PI_SANDBOX=true
# Pi Platform Server API Key, server-side ONLY. Get it from the Pi
# Developer Web Console: app > Settings > Add-ons > API key >
# "Generate new key". The key is shown ONCE — see docs/PI_API_KEY.md.
# Leave empty in development; the app then runs in honest sandbox mode.
PI_API_KEY=
